# Copiar a .env y llenar. Nunca subir .env al repo.

# App de Meta "Ogilvy Social Care" (portafolio Ogilvy Colombia)
META_APP_ID=1664432482008237
META_APP_SECRET=            # también firma los webhooks
META_VERIFY_TOKEN=          # cadena larga al azar; la misma se pone en la configuración del webhook en Meta
META_GRAPH_VERSION=         # versión fijada de Graph API; se confirma en el sprint 1
META_LOGIN_CONFIG_ID=       # configuración de Facebook Login for Business

# OpenAI (llave de proyecto con límite de gasto)
OPENAI_API_KEY=
OPENAI_MODEL=
# Solo para modelos de razonamiento (gpt-5 y siguientes): low para que responda en pocos segundos
OPENAI_REASONING_EFFORT=

# Google: cuenta de servicio con acceso solo a la carpeta "PQR's" del cliente
GOOGLE_SERVICE_ACCOUNT_JSON=

# MySQL 8 o MariaDB 11.4, escuchando solo en 127.0.0.1. Usuario propio de la app, no root.
# Si la clave tiene símbolos, va codificada en la URL (encodeURIComponent).
DATABASE_URL=mysql://social_care:CLAVE@127.0.0.1:3306/social_care

# Cifrado de tokens y campos temporales (32 bytes en base64: openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=

APP_BASE_URL=
# Dirección del panel si vive en otro dominio (en local, mientras no tenga login: http://localhost:3030)
PANEL_URL=
SESSION_SECRET=
# 1 en el servidor: el panel se sirve en el dominio público, detrás de su login.
PANEL_PUBLICO=
# Base de las pruebas: el nombre termina en _test porque se borra en cada corrida.
TEST_DATABASE_URL=
# Hoja de casos (Google): cliente OAuth de aplicación web (URL de regreso: PANEL_URL/api/google/callback),
# clave de API para el selector (restringida a Google Picker API y al dominio del panel) y número del proyecto.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=
GOOGLE_PROJECT_NUMBER=
# Google Business Profile (reseñas): cliente OAuth de aplicación web del proyecto de Google Cloud que pide el acceso
# a la API (puede ser otro proyecto que el de la Hoja de casos). URL de regreso: PANEL_URL/api/gbp/callback.
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
