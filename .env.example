# Copiar a .env y llenar. Nunca subir .env al repo.

# App de Meta "Ogilvy Social Care" (portafolio Ogilvy Colombia)
META_APP_ID=1664432482008237
META_APP_SECRET=            # también firma los webhooks
META_VERIFY_TOKEN=          # cadena larga al azar; la misma se pone en la configuración del webhook en Meta
META_GRAPH_VERSION=         # versión fijada de Graph API; se confirma en el sprint 1
META_LOGIN_CONFIG_ID=       # configuración de Facebook Login for Business

# OpenAI (llave de proyecto con límite de gasto)
OPENAI_API_KEY=
OPENAI_MODEL=
# Solo para modelos de razonamiento (gpt-5 y siguientes): low para que responda en pocos segundos
OPENAI_REASONING_EFFORT=

# Google: cuenta de servicio con acceso solo a la carpeta "PQR's" del cliente
GOOGLE_SERVICE_ACCOUNT_JSON=

# MySQL 8 en el mismo VPS, escuchando solo en 127.0.0.1. Usuario propio de la app, no root.
DATABASE_URL=mysql://social_care:CLAVE@127.0.0.1:3306/social_care

# Cifrado de tokens y campos temporales (32 bytes en base64: openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=

APP_BASE_URL=
# Dirección del panel si vive en otro dominio (en local, mientras no tenga login: http://localhost:3030)
PANEL_URL=
SESSION_SECRET=
